{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PC Toolkit Pro",
  "version": "3.0.0",
  "identifier": "com.ssujitx.pctoolkit",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PC Toolkit Pro",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 700,
        "visible": false,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExRDk5QUJDRkU2MkNFMjYKUldRbXptTCt2SnJaRWJQbzVOWjE5UHhXbWFpSmZqN20wdTRrT0c3T21CRUlQWGNHWlBJWTBTcmQK",
      "endpoints": [
        "https://github.com/SSujitX/pc-toolkit-pro/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
